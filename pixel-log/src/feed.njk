---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name }}</title>
  <subtitle>{{ site.tagline }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <id>{{ site.url }}/</id>
  {% if collections.posts.length %}<updated>{{ collections.posts[0].date | isoDate }}</updated>{% endif %}
  {%- for post in collections.posts | head(20) %}
  <entry>
    <title>{{ post.data.title or (post.date | prettyDate) }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <updated>{{ post.date | isoDate }}</updated>
    <content type="html"><![CDATA[{% if post.data.image %}<p><img src="{{ site.url }}{{ post.data.image }}" alt="{{ post.data.alt or '' }}"></p>{% endif %}{{ post.templateContent | safe }}]]></content>
  </entry>
  {%- endfor %}
</feed>
