---
layout: base.njk
permalink: /index.html
---
<section class="search-box">
  <label for="search">&gt; search:</label>
  <input id="search" type="search" placeholder="type to filter posts..." autocomplete="off" autocapitalize="off" spellcheck="false">
  <p id="search-status" class="status" aria-live="polite"></p>
</section>

<section id="feed" class="feed">
  {% for post in collections.posts %}
  <article class="post" data-search="{{ (post.data.title or '') }} {{ post.templateContent | plainText }} {{ post.data.alt or '' }}">
    <header class="post-head">
      <a class="stamp" href="{{ post.url }}"><time datetime="{{ post.date | isoDate }}">{{ post.date | prettyDate }}</time></a>
      {% if post.data.title %}<h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>{% endif %}
    </header>
    {% if post.data.image %}
    <figure class="photo">
      <a href="{{ post.url }}"><img src="{{ post.data.image }}" alt="{{ post.data.alt or '' }}" loading="lazy"></a>
    </figure>
    {% endif %}
    {% if post.templateContent | plainText %}
    <div class="body">{{ post.templateContent | safe }}</div>
    {% endif %}
  </article>
  {% endfor %}
  <p id="no-results" class="status" hidden>no posts found. try a different word.</p>
</section>
